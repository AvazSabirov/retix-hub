# Адрес, который клиенты используют для подключения WireGuard (домен или IP сервера)
WG_ENDPOINT=hub.retix.uz:51820
WG_PORT=51820

# Вход суперадмина: https://hub.retix.uz/admin
SUPERADMIN_LOGIN=avaz
SUPERADMIN_PASSWORD=смените-меня

# API слушает только localhost, наружу — через nginx
API_HOST=127.0.0.1
API_PORT=8100

# 1 — cookie только по HTTPS (за nginx с SSL). 0 — для локальных тестов
COOKIE_SECURE=1

# Если на хосте iptables-legacy (iptables -V покажет "legacy") — раскомментируйте
# IPTABLES=iptables-legacy
